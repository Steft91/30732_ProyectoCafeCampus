# Cafe Campus - variables generales para Docker Compose
#
# Copiar este archivo como `.env` si se desea activar Sentry o cambiar valores
# globales del stack. No subir `.env` con secretos reales.

# Seguridad del Gateway
JWT_SECRET=cafe_campus_jwt_secret_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# Observabilidad Avance 3
# Ejemplo: SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
SENTRY_DSN=
SENTRY_ENVIRONMENT=avance3-final
SENTRY_CAPTURE_HTTP_ERRORS=false

# Frontend local de demo
FRONTEND_URL=http://localhost:4200

# Delays del benchmark de Avance 1
BENCHMARK_PEDIDOS_DELAY_MS=40
BENCHMARK_INVENTARIO_DELAY_MS=60
BENCHMARK_ASYNC_DELAY_MS=120
